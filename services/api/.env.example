# Puerto HTTP del API
PORT=3000
# URL pública con la que el API arma enlaces (evidencias)
PUBLIC_URL=http://localhost:3000
# Secreto para firmar tokens y enlaces. OBLIGATORIO en producción.
TOKEN_SECRET=cambia-esto
# PostgreSQL + PostGIS (docker compose up postgres). Sin esta variable el API
# usa un almacén en memoria que se borra al reiniciar (no permitido en producción).
DATABASE_URL=postgres://poliaq:poliaq-dev@localhost:5432/poliaq
# off = no aplicar migraciones al arrancar (entonces usa `pnpm db:migrar`)
DB_MIGRATE=on

# SMS: "simulado" (solo muestra el SMS en el log) o "twilio"
SMS_PROVIDER=simulado
# TWILIO_ACCOUNT_SID=ACxxxxxxxx
# TWILIO_AUTH_TOKEN=xxxxxxxx
# Número remitente (+1…) o un Messaging Service SID (MG…)
# TWILIO_FROM=MGxxxxxxxx
# off = no mandar avisos por SMS al ciudadano (unidad asignada, transferencia)
SMS_NOTIFICATIONS=on
# Código OTP fijo que siempre se acepta, solo fuera de producción. Vacío = usar el código del SMS.
OTP_DEV=000000
# Segundos de espera del acuse del CAD antes de escalar al C5
CAD_ACK_TIMEOUT_SEC=30
MAX_REPORTS_PER_HOUR=5
# off = no envía nada a los CAD (solo bandeja en memoria)
CAD_DISPATCH=on
# Webhook y secreto por CAD. Con el simulador local (puerto 4000):
CADS_JSON={"cad-queretaro":{"webhookUrl":"http://localhost:4000/eventos","secreto":"dev-qro"},"cad-corregidora":{"webhookUrl":"http://localhost:4000/eventos","secreto":"dev-corr"},"cad-el-marques":{"webhookUrl":"http://localhost:4000/eventos","secreto":"dev-marques"},"c5-queretaro":{"webhookUrl":"http://localhost:4000/eventos","secreto":"dev-c5"}}
