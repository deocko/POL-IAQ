{
  "name": "@pol-iaq/api",
  "version": "0.1.0",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx watch --env-file-if-exists=.env src/main.ts",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "test": "vitest run",
    "db:migrar": "tsx --env-file-if-exists=.env src/migrar.ts",
    "validar-protocolo": "tsx src/protocolos/validar.ts"
  },
  "dependencies": {
    "@nestjs/common": "11.2.10",
    "@nestjs/core": "11.2.10",
    "@nestjs/platform-express": "11.2.10",
    "@nestjs/platform-socket.io": "11.2.10",
    "@nestjs/websockets": "11.2.10",
    "@pol-iaq/shared": "workspace:*",
    "express": "^5.2.1",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "4.8.3",
    "zod": "4.1.13"
  },
  "devDependencies": {
    "@nestjs/testing": "11.2.10",
    "@types/express": "^5.0.6",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "socket.io-client": "^4.8.4",
    "supertest": "^7.3.2"
  }
}
