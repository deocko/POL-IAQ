# ── Forma 1: ALOJADO por POL-IAQ (varios municipios en un mismo adaptador) ─────────────────
# Un objeto por CAD. secreto = el del alta del CAD en POL-IAQ; cadUrl = API del CAD del municipio.
# ADAPTADOR_TENANTS_JSON={"cad-san-juan-del-rio":{"secreto":"<32+ caracteres>","cadUrl":"https://cad.sanjuandelrio.example/api","tokenHaciaCad":"<token>","tokenDesdeCad":"<token>"}}

# ── Forma 2: INSTALADO en el municipio (un solo CAD) ───────────────────────────────────────
CAD_ID=cad-san-juan-del-rio
POLIAQ_SECRETO=cambia-esto-por-el-secreto-del-alta-32c
CAD_URL=http://localhost:4000
# Token que el CAD presenta al adaptador (obligatorio) y el que el adaptador presenta al CAD (opcional).
CAD_TOKEN_ENTRADA=cambia-esto
CAD_TOKEN_SALIDA=

# ── Común ─────────────────────────────────────────────────────────────────────────────────
PORT=4100
POLIAQ_URL=http://localhost:3000
# mTLS hacia POL-IAQ (rutas a PEM). Obligatorio en producción si POL-IAQ registró la huella del certificado.
# POLIAQ_MTLS_CERT=/run/secrets/cad.crt
# POLIAQ_MTLS_KEY=/run/secrets/cad.key
# POLIAQ_MTLS_CA=/run/secrets/poliaq-ca.crt
# Esperas entre reintentos hacia POL-IAQ (ms) y cada cuánto se manda el lote de AVL.
REINTENTOS_MS=0,1000,2000,4000,8000,16000
AVL_CADA_MS=5000
