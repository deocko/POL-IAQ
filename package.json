{
  "name": "pol-iaq",
  "private": true,
  "description": "Plataforma ciudadana de reporte de emergencias para Querétaro, integrada con los CAD municipales y el C5.",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --filter @pol-iaq/shared --filter @pol-iaq/api --filter @pol-iaq/cad-simulator build",
    "typecheck": "pnpm -r --filter @pol-iaq/shared --filter @pol-iaq/api --filter @pol-iaq/cad-simulator typecheck",
    "test": "pnpm -r --filter @pol-iaq/shared --filter @pol-iaq/api --filter @pol-iaq/cad-simulator test",
    "dev:api": "pnpm --filter @pol-iaq/api dev",
    "dev:cad": "pnpm --filter @pol-iaq/cad-simulator dev",
    "dev:web": "pnpm --filter @pol-iaq/web dev",
    "dev:ciudadano": "pnpm --filter @pol-iaq/ciudadano start"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "@types/node": "22.20.5",
    "vitest": "4.1.12",
    "tsx": "4.23.15"
  }
}
